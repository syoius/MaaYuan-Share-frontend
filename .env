# 本地开发端口
PORT=3000

# 如果需要使用生产环境的API，请把下面一行注释掉，或者在.env.development.local中覆盖
VITE_API=https://share.maayuan.com/api
# Siming generator service base URL (MaaYuan-SiMing)
VITE_SIMING_BASE_URL=https://share.maayuan.top/simingapi

# 是否启用“注册码注册”模式（true/false），默认关闭
VITE_USE_REG_CODE=false
VITE_ENABLE_ANNOUNCEMENT=false

# 域名迁移提示（弹窗一次）：仅当访问 host 命中 VITE_SITE_RETIRE_HOST 时显示
# 留空 VITE_SITE_RETIRE_HOST 则完全关闭该提示
VITE_SITE_RETIRE_HOST=share.maayuan.fun:16666
VITE_SITE_RETIRE_DATE=2026年9月30日
VITE_SITE_RETIRE_TARGET=https://share.maayuan.com
